PORT=3010
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
# Public browser origin allowed to call this server (production example: https://example.com).
# Leave blank for local development at http://localhost:3010.
APP_ORIGIN=
# Required for genuine AI-generated itineraries. Never put this key in script.js or index.HTML.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Optional: Amadeus Self-Service travel API.
# Add these only to .env (never to HTML or browser JavaScript).
# Create free credentials at https://developers.amadeus.com/
# Both values are required. A single API key cannot authenticate Amadeus.
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_ENVIRONMENT=test

# Operations dashboard: set this to the email address of the account allowed to manage packages and bookings.
ADMIN_EMAIL=

# Razorpay: required for live UPI, cards and EMI. Keep these server-only values out of browser code.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional notifications. Brevo sends booking and password-reset emails.
# Twilio SMS is ready for future phone-number collection at checkout.
NOTIFICATION_FROM_EMAIL=
BREVO_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
